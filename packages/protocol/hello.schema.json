{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SSUX negotiation message",
  "$defs": {
    "version": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "minVersion", "maxVersion", "capabilities"],
      "properties": {
        "type": { "const": "hello" },
        "minVersion": { "$ref": "#/$defs/version" },
        "maxVersion": { "$ref": "#/$defs/version" },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "maxFrameBytes", "capabilities"],
      "properties": {
        "type": { "const": "welcome" },
        "version": { "$ref": "#/$defs/version" },
        "maxFrameBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "code"],
      "properties": {
        "type": { "const": "error" },
        "code": { "enum": ["invalid-hello", "incompatible-version"] }
      }
    }
  ]
}
